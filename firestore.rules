rules_version = '2';

// zero-cost-ai-dating — Firestore security rules.
//
// This app runs entirely in the browser on the Firebase Spark (free) plan: there are no
// Cloud Functions and no trusted server code anywhere. These rules are therefore the ONLY
// server-side enforcement that exists. Anything the client is not allowed to do must be
// impossible here, and every write is shape-checked against the data model in the
// implementation contract (§4) so a tampered client cannot poison other people's feeds.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------------

    // Any authenticated caller (email/password or Google). Anonymous/demo sessions never
    // reach Firestore — they live purely in localStorage.
    function isSignedIn() {
      return request.auth != null;
    }

    // The caller owns the document keyed by this uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The `users` array of a match document, read once from the parent match.
    function matchUsers(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    // The caller is one of the two people in the given match.
    function isParticipant(matchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in matchUsers(matchId);
    }

    // An ISO-8601 timestamp, the way the store writes one: `new Date().toISOString()` is
    // twenty-four characters and nothing here is longer.
    //
    // The cap is the point. Every document in this project carries at least one of these
    // and each was checked only as `is string`, which bounds nothing — so a swipe, a
    // match, a message or a profile could still be padded to Firestore's 1 MiB ceiling
    // through a field called `createdAt`, with a closed key list in front of it doing
    // exactly nothing about it. Closing the key list bounded how many fields a document
    // may have; this bounds how big one may be.
    function stampOk(v) {
      return v is string && v.size() <= 40;
    }

    // A list's *contents*, not just how many elements it holds.
    //
    // `size()` bounds the count and says nothing about what is inside, so
    // `photos: ['x' repeated 300000]` satisfied every check in this file: one
    // element, comfortably under six. Same for `interests`, `blocked` and the
    // keys and values of `learning.interestAffinity`. `docs/DEPLOY.md` listed
    // exactly those as the size hole that could not be closed, on the grounds
    // that the rules language cannot iterate a list.
    //
    // It cannot. It does not need to: `join` concatenates a list into a string,
    // and a string can be measured. One expression bounds every element at once,
    // whatever the split between them — which is the property that matters,
    // because the ceiling being defended is the document's, not any one field's.
    // Non-strings are stringified rather than rejected, so a numeric list is
    // measured too, and an element that is a map or a list makes `join` fail,
    // which denies.
    function listCharsOk(v, cap) {
      return v.join('').size() <= cap;
    }

    // There are deliberately no strOk(v, cap) / numIn(v, lo, hi) helpers here, and
    // the repetition below is not an oversight.
    //
    // A rules request may evaluate at most 1000 expressions, and this file's user
    // document validator sits close enough to that ceiling that the margin is
    // measured by a test (`rules-tests/specs/08-budget.rules.js`). Folding the
    // repeated comparisons into helpers reads better and costs more: measured
    // against this very file, a clause that is a call — `stampOk(d.createdAt)` —
    // costs about 2.2 times a plain `d.uid is string`, where its body alone is
    // worth about 1.5. Wrapping every bound in one spent the remaining margin and
    // every user document write began failing, as a flat `permission-denied`
    // naming no field, which is how running out of budget always looks. (The
    // per-call overhead that leaves is under one clause, so deleting a lone
    // pass-through wrapper buys clarity and no measurable budget.)
    //
    // `stampOk` and `listCharsOk` stay because each is called for a construct
    // there is no short way to write, and each earns its call.

    // ---------------------------------------------------------------------------
    // users/{uid} — the profile documents that power discovery
    // ---------------------------------------------------------------------------
    //
    // Readable by any signed-in user because discovery has to scan candidates locally
    // (the matching engine is on-device). Writable only by the owner, and only in the
    // exact shape the app produces.
    match /users/{uid} {

      // profile.personality — five integer axes, 0..100, all optional.
      //
      // The key list is closed, and that is not symmetry for its own sake. This
      // validator named five keys and bounded neither the others nor how many there
      // were, so a personality map could carry ten thousand fields and pass; and the
      // projection copies `personality` across verbatim, so a private document the
      // rules accepted could produce a `discovery/{uid}` write they refused. The
      // projection write is best-effort by design — it must never fail the profile
      // save that caused it — so the account would save, silently stop publishing,
      // and vanish from every deck with nothing said. That is the `lastActiveAt: null`
      // failure exactly, and `store-tests/specs/04-rules-accept.store.js` now replays
      // a real projection against this file so it cannot happen quietly again.
      function personalityOk(pp) {
        return pp == null || (
          pp is map
          && pp.keys().hasOnly(['openness', 'conscientiousness', 'extraversion',
                                'agreeableness', 'stability'])
          && (!('openness' in pp) || (pp.openness is number && pp.openness >= 0 && pp.openness <= 100))
          && (!('conscientiousness' in pp) || (pp.conscientiousness is number && pp.conscientiousness >= 0 && pp.conscientiousness <= 100))
          && (!('extraversion' in pp) || (pp.extraversion is number && pp.extraversion >= 0 && pp.extraversion <= 100))
          && (!('agreeableness' in pp) || (pp.agreeableness is number && pp.agreeableness >= 0 && pp.agreeableness <= 100))
          && (!('stability' in pp) || (pp.stability is number && pp.stability >= 0 && pp.stability <= 100))
        );
      }

      // profile.location — either null or a real coordinate pair with a short label.
      function locationOk(loc) {
        return loc == null || (
          loc is map
          && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
          && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
          && (!('label' in loc) || (loc.label is string && loc.label.size() <= 120))
        );
      }

      // profile.* — bounded bio, capped interest/photo lists, known gender values.
      function profileOk(p) {
        return p is map
          && (!('bio' in p) || (p.bio is string && p.bio.size() <= 500))
          // 12 slugs from a fixed vocabulary whose longest entry is 12 characters,
          // so 240 is nearly double what the editor can produce.
          && (!('interests' in p) || (p.interests is list && p.interests.size() <= 12
                                      && listCharsOk(p.interests, 240)))
          // 6 links at 1024 characters each, which is what the profile editor
          // now enforces one at a time so the refusal is visible there rather
          // than arriving as an unexplained permission-denied on save.
          && (!('photos' in p) || (p.photos is list && p.photos.size() <= 6
                                   && listCharsOk(p.photos, 6144)))
          && (!('gender' in p) || (p.gender in ['woman', 'man', 'nonbinary', 'other']))
          && (!('pronouns' in p) || (p.pronouns is string && p.pronouns.size() <= 40))
          && (!('birthdate' in p) || (p.birthdate == null || (p.birthdate is string && p.birthdate.size() == 10)))
          && (!('age' in p) || p.age == null || (p.age is number && p.age >= 18 && p.age <= 120))
          && (!('showAge' in p) || (p.showAge is bool))
          && (!('showDistance' in p) || (p.showDistance is bool))
          && (!('personality' in p) || personalityOk(p.personality))
          && (!('location' in p) || locationOk(p.location));
      }

      // preferences.* — the mutual filters. Age window must stay inside 18..100 and
      // ordered, distance inside 1..500 km (500 means "anywhere").
      function prefsOk(f) {
        return f is map
          && (!('ageMin' in f) || (f.ageMin is number && f.ageMin >= 18 && f.ageMin <= 100))
          && (!('ageMax' in f) || (f.ageMax is number && f.ageMax >= 18 && f.ageMax <= 100))
          && (!(('ageMin' in f) && ('ageMax' in f)) || f.ageMin <= f.ageMax)
          && (!('maxDistanceKm' in f) || (f.maxDistanceKm is number && f.maxDistanceKm >= 1 && f.maxDistanceKm <= 500))
          // The same four words `profile.gender` allows, and nothing else. A cap of
          // four *elements* bounded neither what they were nor how long they were;
          // naming them bounds both, in one clause rather than two.
          && (!('interestedIn' in f) || (f.interestedIn is list
                                         && f.interestedIn.hasOnly(['woman', 'man', 'nonbinary', 'other'])))
          && (!('theme' in f) || (f.theme in ['system', 'light', 'dark']))
          && (!('notifications' in f) || (f.notifications is bool))
          && (!('discoverable' in f) || f.discoverable is bool);
      }

      // learning.* and usage.* — small bookkeeping maps; keep the counters sane so the
      // document cannot be grown without bound.
      //
      // Each sub-map is passed into its own function rather than reached through
      // `d.learning.likeCount` at every mention. That is not tidiness: a rules
      // request may evaluate at most 1000 expressions, every step of a path is
      // one of them, and this validator walks the same three-deep paths two and
      // three times per clause. `rules-tests/specs/08-budget.rules.js` measures
      // what is left of that allowance.

      // learning.interestAffinity — interest slugs mapped to weights the engine
      // has already clamped to -1..1 and rounded to four places. Both sides are
      // measured: a key list capped at 60 bounded neither the slugs nor what they
      // mapped to, and one value could be a megabyte-long string under the name
      // `hiking`.
      function affinityOk(m) {
        return m is map
          && m.keys().size() <= 60
          && listCharsOk(m.keys(), 1200)
          && listCharsOk(m.values(), 1500);
      }

      function learningOk(l) {
        return l is map
          && (!('interestAffinity' in l) || affinityOk(l.interestAffinity))
          && (!('likeCount' in l) || (l.likeCount is number && l.likeCount >= 0))
          && (!('passCount' in l) || (l.passCount is number && l.passCount >= 0));
      }

      function usageOk(u) {
        return u is map
          && (!('date' in u) || (u.date is string && u.date.size() == 10))
          && (!('likes' in u) || (u.likes is number && u.likes >= 0))
          && (!('superLikes' in u) || (u.superLikes is number && u.superLikes >= 0))
          && (!('rewinds' in u) || (u.rewinds is number && u.rewinds >= 0));
      }

      // The whole UserDoc: a closed top-level key list and every nested validator.
      // `createdAt` has to be present so that the immutability check below can always
      // compare it without tripping over a missing field, which the unconditional
      // `stampOk(d.createdAt)` a few lines down is what guarantees.
      //
      // Closed rather than merely complete: `hasAll` says the required keys are there and
      // nothing about the rest, so an account could pad its own document to the 1 MiB
      // ceiling with fields no part of this app reads. That is a smaller lever than the
      // swipe collection — one document per account rather than one per swipe — but it is
      // the same lever, and there is no reason to leave it. The list is the fourteen keys
      // the store's own DEFAULT_USER carries, and tests/projection.test.js compares the
      // two so neither can drift without the other.
      function userDocOk(d) {
        return d.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt',
                                 'lastActiveAt', 'profileComplete', 'plan', 'planSince',
                                 'profile', 'preferences', 'learning', 'usage', 'blocked'])
          // Two checks that used to be here are gone, and both were redundant
          // rather than relaxed — this rule has an expression budget to answer to
          // (`rules-tests/specs/08-budget.rules.js`), and a check that says nothing
          // new is the first thing to spend.
          //
          // A `hasAll` naming seven required keys: every one of them is
          // dereferenced unconditionally in the lines below, and reading a key a
          // map does not have is an error that denies the write. `01-users`
          // removes each of the seven in turn and confirms the write still fails.
          //
          // `d.uid is string`: create requires `request.resource.data.uid == uid`,
          // which is the document id and therefore a string, and update freezes it
          // against the stored value. Neither path could reach this line without it.
          && d.email is string && d.email.size() <= 320
          && d.displayName is string && d.displayName.size() <= 60
          && d.plan in ['free', 'premium']
          && (!('planSince' in d) || (d.planSince == null || stampOk(d.planSince)))
          && (!('profileComplete' in d) || (d.profileComplete is bool))
          && stampOk(d.createdAt)
          && (!('updatedAt' in d) || stampOk(d.updatedAt))
          // null is how the store spells "never active", exactly as it spells an
          // unset planSince above. Requiring a string here rejected any user
          // document created through updateUser's upsert path — the shape the
          // store has always written, and the demo adapter accepts.
          && (!('lastActiveAt' in d) || (d.lastActiveAt == null || stampOk(d.lastActiveAt)))
          && profileOk(d.profile)
          && prefsOk(d.preferences)
          // These three were behind a `bookkeepingOk(d)` wrapper that did nothing but
          // forward them. A function call costs about 2.2 plain clauses here, so a
          // pass-through is one of the few things in this file that is pure overhead —
          // and one hop less to follow when reading what a user document may contain.
          && (!('learning' in d) || learningOk(d.learning))
          && (!('usage' in d) || usageOk(d.usage))
          // 1000 uids at 48 characters each. A Firebase Auth uid is 28.
          && (!('blocked' in d) || (d.blocked is list && d.blocked.size() <= 1000
                                    && listCharsOk(d.blocked, 48000)));
      }

      // Identity fields are set once at sign-up and can never be rewritten afterwards —
      // this is what stops an account from impersonating another or back-dating itself.
      function identityUnchanged() {
        return request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Owner only. Other people are discovered through discovery/{uid}, a
      // projection holding just the public fields — email, birthdate, block
      // lists, usage counters and learned affinities never leave the account.
      allow read: if isOwner(uid);

      // Create: only your own document, and the embedded uid must match the doc id.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && userDocOk(request.resource.data);

      // Update: only your own document, shape re-validated, identity fields frozen.
      allow update: if isOwner(uid)
        && userDocOk(request.resource.data)
        && identityUnchanged();

      // Delete: account deletion, owner only.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------------
    // discovery/{uid} — the public projection of a profile
    // ---------------------------------------------------------------------------
    //
    // The on-device matching engine needs to scan other people's profiles, so this
    // collection is readable by any signed-in user — and therefore it may contain
    // ONLY fields meant for other users. `hasOnly` guarantees a tampered client
    // cannot smuggle private fields (email, birthdate, blocked, learning, usage)
    // into the readable copy. The app writes it as a mirror of users/{uid} on
    // every profile save, with coordinates rounded to ~1 km.
    match /discovery/{uid} {

      // The public subset of profile.* — same bounds as the private doc, but the
      // key list is closed: no birthdate here, only the derived age.
      function discoveryProfileOk(p) {
        return p is map
          && p.keys().hasOnly(['age', 'gender', 'pronouns', 'bio', 'photos', 'interests',
                               'personality', 'location', 'showAge', 'showDistance'])
          && (!('bio' in p) || (p.bio is string && p.bio.size() <= 500))
          // The same content bounds as the private document, and this is the copy
          // every signed-in account downloads to build a deck.
          && (!('interests' in p) || (p.interests is list && p.interests.size() <= 12
                                      && listCharsOk(p.interests, 240)))
          && (!('photos' in p) || (p.photos is list && p.photos.size() <= 6
                                   && listCharsOk(p.photos, 6144)))
          && (!('gender' in p) || (p.gender in ['woman', 'man', 'nonbinary', 'other']))
          && (!('pronouns' in p) || (p.pronouns is string && p.pronouns.size() <= 40))
          && (!('age' in p) || p.age == null || (p.age is number && p.age >= 18 && p.age <= 120))
          && (!('showAge' in p) || (p.showAge is bool))
          && (!('showDistance' in p) || (p.showDistance is bool))
          // `location` and `personality` were both on the key list above with no
          // validator at all, so the one world-readable collection in the project
          // accepted a megabyte under either name. Every signed-in user reads these
          // documents to build a deck. `location` was found by eye a few rounds ago;
          // `personality` outlived that pass, and was found by asking the question
          // mechanically instead — tests/limits.test.js now checks that every key an
          // allowlist admits is one something in the same validator looks at.
          && (!('location' in p) || locationOk(p.location))
          && (!('personality' in p) || personalityOk(p.personality));
      }

      // Restated rather than shared: a rules function does not cross a `match` block,
      // and the private document's copy is two hundred lines and one collection away.
      // Same five axes, same range — and a closed key list this time, which the private
      // copy does not have and does not need, since `profileOk` is not the document
      // anybody else can read.
      function personalityOk(pp) {
        return pp == null || (
          pp is map
          && pp.keys().hasOnly(['openness', 'conscientiousness', 'extraversion',
                                'agreeableness', 'stability'])
          && (!('openness' in pp) || (pp.openness is number && pp.openness >= 0 && pp.openness <= 100))
          && (!('conscientiousness' in pp) || (pp.conscientiousness is number && pp.conscientiousness >= 0 && pp.conscientiousness <= 100))
          && (!('extraversion' in pp) || (pp.extraversion is number && pp.extraversion >= 0 && pp.extraversion <= 100))
          && (!('agreeableness' in pp) || (pp.agreeableness is number && pp.agreeableness >= 0 && pp.agreeableness <= 100))
          && (!('stability' in pp) || (pp.stability is number && pp.stability >= 0 && pp.stability <= 100))
        );
      }

      // Either null or a real coordinate pair with a short label. Same shape the private
      // document is held to; stated again because rules functions do not cross a match
      // block, and a projection that drifted from the original is the failure this file
      // has already had once.
      function locationOk(loc) {
        return loc == null || (
          loc is map
          && loc.keys().hasOnly(['label', 'lat', 'lng'])
          && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
          && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
          && (!('label' in loc) || (loc.label is string && loc.label.size() <= 120))
        );
      }

      // The public subset of preferences.* — just the mutual discovery filters.
      function discoveryPrefsOk(f) {
        return f is map
          && f.keys().hasOnly(['interestedIn', 'ageMin', 'ageMax', 'maxDistanceKm', 'discoverable'])
          && (!('ageMin' in f) || (f.ageMin is number && f.ageMin >= 18 && f.ageMin <= 100))
          && (!('ageMax' in f) || (f.ageMax is number && f.ageMax >= 18 && f.ageMax <= 100))
          && (!('maxDistanceKm' in f) || (f.maxDistanceKm is number && f.maxDistanceKm >= 1 && f.maxDistanceKm <= 500))
          && (!('interestedIn' in f) || (f.interestedIn is list
                                         && f.interestedIn.hasOnly(['woman', 'man', 'nonbinary', 'other'])))
          && (!('discoverable' in f) || f.discoverable is bool);
      }

      // The whole projection: a closed key list at the top level too.
      function discoveryOk(d) {
        return d.keys().hasOnly(['uid', 'displayName', 'profileComplete', 'lastActiveAt',
                                 'profile', 'preferences'])
          && d.uid == uid
          && d.displayName is string && d.displayName.size() <= 60
          && (!('profileComplete' in d) || (d.profileComplete is bool))
          && (!('lastActiveAt' in d) || stampOk(d.lastActiveAt))
          && (!('profile' in d) || discoveryProfileOk(d.profile))
          && (!('preferences' in d) || discoveryPrefsOk(d.preferences));
      }

      // Read: any signed-in user — this is the discovery surface.
      allow read: if isSignedIn();

      // Write: only your own projection, only in the public shape. The partial
      // lastActiveAt refresh must also stay inside the closed key list.
      allow create: if isOwner(uid) && discoveryOk(request.resource.data);
      allow update: if isOwner(uid) && discoveryOk(request.resource.data);

      // Delete: account deletion, owner only.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------------
    // swipes/{swipeId} — one document per (from, to) decision, id is `from_to`
    // ---------------------------------------------------------------------------
    match /swipes/{swipeId} {

      // A swipe is a tiny immutable record; the doc id encodes both parties so a client
      // cannot create two conflicting swipes for the same pair.
      //
      // `hasOnly`, not `hasAll`. `hasAll` says the required keys are present and says
      // nothing about the rest, so a swipe could carry any number of extra fields and be
      // padded to the 1 MiB document ceiling. Nothing about this record is worth a
      // megabyte, and this is the cheapest such write in the project: creating one needs
      // only a signed-in account and a uid, and uids are enumerable from the
      // world-readable discovery collection. A Spark project gets 1 GiB of storage, which
      // is a thousand documents at that size — and the daily swipe limit that would
      // otherwise slow it down is enforced in the browser, so it does not apply to a
      // client that has stopped cooperating. Bounding the shape is what bounds the write.
      function swipeOk(d) {
        return d.keys().hasOnly(['id', 'from', 'to', 'action', 'createdAt'])
          && d.keys().hasAll(['from', 'to', 'action', 'createdAt'])
          && d.from is string && d.from.size() > 0
          && d.to is string && d.to.size() > 0
          && d.from != d.to
          && d.action in ['like', 'pass', 'super']
          && stampOk(d.createdAt)
          && (!('id' in d) || (d.id == swipeId))
          && swipeId == d.from + '_' + d.to;
      }

      // Read: the swipes you made, plus the swipes aimed at you — the latter is required
      // for match detection and for the premium "who liked you" list. No one else's.
      //
      // `resource` is null when the requested document does not exist, and dereferencing
      // it would raise an evaluation error (surfacing to the client as PERMISSION_DENIED
      // rather than an empty snapshot). The client reads absent documents constantly:
      // every first swipe reads its own not-yet-written record and the usually-absent
      // reciprocal one, and `getLikesReceived` asks, once per person who liked you,
      // whether `swipes/{me}_{them}` exists. So a miss has to be an allowed read that
      // reports `exists == false`.
      //
      // Which miss, though, is the whole question. This used to be a bare
      // `resource == null`, allowing every signed-in caller to read every absent
      // document — and that is an existence oracle rather than nothing, because the
      // answers differ: an empty snapshot means the document is not there, a denial
      // means it is there and is not yours. Anyone could therefore learn that Alice has
      // swiped on Bob, for any pair, without reading a byte of it — and uids are
      // enumerable, since `discovery/{uid}` is world-readable to signed-in users and its
      // document id is the uid. The reports rule below already refuses misses for exactly
      // this reason and says so; these two disagreed with it.
      //
      // The id is `from_to`, so the pair is in the name: a caller may probe a miss only
      // when they are one half of it. That is precisely what the client does, and a uid
      // is never a substring match — `in` compares whole elements — so a uid that somehow
      // contained an underscore would be denied rather than admitted.
      allow read: if isSignedIn()
        && (resource == null
              ? request.auth.uid in swipeId.split('_')
              : (resource.data.from == request.auth.uid
                 || resource.data.to == request.auth.uid));

      // Create: you may only record swipes authored by yourself.
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && swipeOk(request.resource.data);

      // Never editable — a rewind deletes and re-creates instead.
      allow update: if false;

      // Delete: your own swipe (the rewind path), or a swipe aimed at you — an
      // inbound like is data about you, and account deletion must be able to
      // purge it.
      allow delete: if isSignedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---------------------------------------------------------------------------
    // matches/{matchId} — id is the two uids sorted and joined with '_'
    // ---------------------------------------------------------------------------
    match /matches/{matchId} {

      // Exactly two participants, sorted, and the doc id derived from them. The caller
      // must be one of them, so nobody can invent a match between two other people.
      function matchOk(d) {
        return d.keys().hasOnly(['id', 'users', 'createdAt', 'lastMessage', 'lastMessageAt', 'unread'])
          && d.keys().hasAll(['users', 'createdAt'])
          && d.users is list
          && d.users.size() == 2
          && d.users[0] is string
          && d.users[1] is string
          && d.users[0] < d.users[1]
          && matchId == d.users[0] + '_' + d.users[1]
          && request.auth.uid in d.users
          && (!('id' in d) || (d.id == matchId))
          && stampOk(d.createdAt)
          && (!('lastMessage' in d) || (d.lastMessage == null || (d.lastMessage is string && d.lastMessage.size() <= 1000)))
          && (!('lastMessageAt' in d) || (d.lastMessageAt == null || stampOk(d.lastMessageAt)))
          // The unread map may be keyed only by the two participants, and each count is
          // a number. `keys().size() <= 2` bounded the count of keys and neither their
          // names nor their values, so two megabyte strings passed it.
          && (!('unread' in d) || (
            d.unread is map
            && d.unread.keys().hasOnly(d.users)
            && (!(d.users[0] in d.unread) || (d.unread[d.users[0]] is number && d.unread[d.users[0]] >= 0))
            && (!(d.users[1] in d.unread) || (d.unread[d.users[1]] is number && d.unread[d.users[1]] >= 0))
          ));
      }

      // The other side of a match document, from the caller's point of view.
      function otherOf(d) {
        return d.users[0] == request.auth.uid ? d.users[1] : d.users[0];
      }

      // The swipe the other person aimed at the caller — `swipes/{other}_{me}`.
      function inboundSwipe(d) {
        return /databases/$(database)/documents/swipes/$(otherOf(d) + '_' + request.auth.uid);
      }

      // True only when that person has actually liked (or super-liked) the caller, which
      // is exactly the condition recordSwipe checks client-side before writing a match.
      function likedByOther(d) {
        return exists(inboundSwipe(d))
          && get(inboundSwipe(d)).data.action in ['like', 'super'];
      }

      // Whether `owner` has blocked `subject`.
      //
      // A block list lives in the owner's private `users/{uid}` document, which no other
      // client may read — deliberately, since publishing who you have blocked is its own
      // disclosure. A rule may read it: `get()` is evaluated server-side and is not itself
      // subject to the read rules. That makes this the only place in a project with no
      // server where a block can be *enforced* rather than merely honoured by a
      // cooperating client, and a blocked account is exactly the one whose client should
      // not be trusted to cooperate.
      //
      // `get('blocked', [])` rather than a membership test on the key, so an account
      // written before that field existed reads as blocking nobody instead of erroring.
      function hasBlocked(owner, subject) {
        return exists(/databases/$(database)/documents/users/$(owner))
          && subject in get(/databases/$(database)/documents/users/$(owner)).data.get('blocked', []);
      }

      // Read: participants only. As with swipes, a read of a document that does not exist
      // has `resource == null` and dereferencing it errors instead of returning an empty
      // snapshot — and rewind probes the (usually absent) match document for the pair on
      // every undo, inside a transaction, so that miss has to be allowed.
      //
      // Allowed by the id, not unconditionally, for the reason spelled out on the swipes
      // rule above: a bare `resource == null` answers every caller for every id, and the
      // difference between an empty snapshot and a denial tells them whether two people
      // they named have matched. That is a more sensitive fact than a swipe. The id is
      // the sorted pair, so a caller may probe only a match they would be in.
      allow read: if isSignedIn()
        && (resource == null
              ? request.auth.uid in matchId.split('_')
              : request.auth.uid in resource.data.users);

      // Create: a participant creating a well-formed match document, but only once the
      // other person has actually liked them back. Without that proof any signed-in user
      // could mint a match against a uid found through the (deliberately open) users
      // read and then message a stranger, since message writes are gated purely on
      // membership of the match. The client already satisfies this: recordSwipe writes
      // the swipe and only then, as a separate operation, creates the match.
      //
      // ...and not once they have blocked you. Unmatching alone is not durable: it deletes
      // the match document but not the like underneath it, so `likedByOther` still holds
      // and the other side can simply write the document again and carry on messaging.
      // The report dialog's "Block and unmatch" is the flow that has to survive that, and
      // this is what makes it survive.
      //
      // Only that direction is checked. "I blocked them" is enforced by my own client,
      // and a tampered client that matched somebody it had itself blocked would only be
      // reaching a person who liked it and has not blocked it back — self-inflicted, not
      // a safety failure — while checking it would double the document reads this rule
      // spends, against a hard limit of ten per request that `likedByOther` already uses
      // two of.
      allow create: if isSignedIn()
        && matchOk(request.resource.data)
        && likedByOther(request.resource.data)
        && !hasBlocked(otherOf(request.resource.data), request.auth.uid);

      // Update: participants only, for lastMessage / lastMessageAt / unread counters.
      // The participant list itself is frozen.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && matchOk(request.resource.data);

      // Delete: unmatching, by either participant.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;

      // -------------------------------------------------------------------------
      // matches/{matchId}/messages/{msgId} — chat, append-only
      // -------------------------------------------------------------------------
      match /messages/{msgId} {

        // Read: participants of the parent match.
        allow read: if isParticipant(matchId);

        // Create: a participant, writing as themselves, with 1..1000 chars of text.
        // The 1000-character cap bounds `text` and, with `hasAll`, bounded nothing else:
        // the document could carry any other field at any size, so a capped message could
        // still be a megabyte. Closing the key list is what makes the cap mean what it
        // reads as.
        allow create: if isParticipant(matchId)
          && request.resource.data.keys().hasOnly(['id', 'from', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && (!('id' in request.resource.data) || request.resource.data.id == msgId)
          && stampOk(request.resource.data.createdAt);

        // Messages are never edited, so neither side can rewrite what was said.
        // Deletes are allowed to participants because unmatch and account
        // deletion must purge the conversation before removing the parent match
        // (a deleted match would strand its messages forever, unreadable but
        // undeletable). The trade-off is deliberate: participants can remove
        // messages, nobody can alter them.
        allow update: if false;
        allow delete: if isParticipant(matchId);
      }
    }

    // ---------------------------------------------------------------------------
    // reports/{reportId} — the abuse-report queue, id is `from_about`
    // ---------------------------------------------------------------------------
    //
    // Anyone signed in can file a report about another account. The deterministic
    // id bounds the queue — one report per (reporter, subject) pair, so a single
    // account cannot flood the queue or burn the write quota with random ids —
    // and the subject must actually exist in discovery, so reports cannot be
    // filed against invented uids. Reports are invisible to everyone except
    // their own author: the reported party can never enumerate, alter or retract
    // them. Authors can read and delete only their own (that is what lets
    // account deletion honestly purge everything the account wrote). The project
    // owner reviews the queue in the Firebase console or with admin credentials.
    match /reports/{reportId} {

      function reportOk(d) {
        return d.keys().hasOnly(['id', 'from', 'about', 'reason', 'details', 'createdAt'])
          && d.from == request.auth.uid
          && d.about is string && d.about.size() > 0
          && d.about != d.from
          && reportId == d.from + '_' + d.about
          && exists(/databases/$(database)/documents/discovery/$(d.about))
          && d.reason in ['fake-profile', 'inappropriate-content', 'harassment', 'underage', 'scam-or-spam', 'other']
          && (!('details' in d) || (d.details is string && d.details.size() <= 500))
          // `id` was on the key list above with no validator at all — the same
          // oversight `discovery/{uid}`'s `location` had, and the swipe, match and
          // message rules all pin their `id` to the document id. Without it the one
          // collection whose entire design is "a deterministic id bounds the queue"
          // accepted a megabyte under the field named `id`, and the queue it bounds
          // is the abuse queue.
          && (!('id' in d) || (d.id == reportId))
          && stampOk(d.createdAt);
      }

      allow create: if isSignedIn() && reportOk(request.resource.data);

      // Only your own reports, and only ever your own: list queries must be
      // constrained to from == you. Reads of missing documents deny too, so a
      // probe of `x_y` cannot distinguish "no such report" from "not yours" —
      // the reported party can never learn a report about them exists.
      allow read: if isSignedIn()
        && resource != null
        && resource.data.from == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // ---------------------------------------------------------------------------
    // Everything else is denied. New collections must opt in above, explicitly.
    // ---------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
