rules_version = '2';

// zero-cost-ai-dating — Firestore security rules.
//
// This app runs entirely in the browser on the Firebase Spark (free) plan: there are no
// Cloud Functions and no trusted server code anywhere. These rules are therefore the ONLY
// server-side enforcement that exists. Anything the client is not allowed to do must be
// impossible here, and every write is shape-checked against the data model in the
// implementation contract (§4) so a tampered client cannot poison other people's feeds.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------------

    // Any authenticated caller (email/password or Google). Anonymous/demo sessions never
    // reach Firestore — they live purely in localStorage.
    function isSignedIn() {
      return request.auth != null;
    }

    // The caller owns the document keyed by this uid.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The `users` array of a match document, read once from the parent match.
    function matchUsers(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    // The caller is one of the two people in the given match.
    function isParticipant(matchId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in matchUsers(matchId);
    }

    // An ISO-8601 timestamp, the way the store writes one: `new Date().toISOString()` is
    // twenty-four characters and nothing here is longer.
    //
    // The cap is the point. Every document in this project carries at least one of these
    // and each was checked only as `is string`, which bounds nothing — so a swipe, a
    // match, a message or a profile could still be padded to Firestore's 1 MiB ceiling
    // through a field called `createdAt`, with a closed key list in front of it doing
    // exactly nothing about it. Closing the key list bounded how many fields a document
    // may have; this bounds how big one may be.
    function stampOk(v) {
      return v is string && v.size() <= 40;
    }

    // A stamp the writer's clock could have produced just now: the digit layout
    // `new Date().toISOString()` writes, and no later than a day past the server's
    // own clock.
    //
    // stampOk bounds how big a stamp is and nothing about what it says, so
    // `9999-12-31T23:59:59.999Z` passed it — and three things order other people's
    // screens by these stamps. `listCandidates` walks `discovery` newest-first by
    // `lastActiveAt` and the engine scored a stamp ahead of the clock as active this
    // instant; a thread sorts its messages by `createdAt`; the conversation list
    // sorts by `lastMessageAt`, else `createdAt`. A stamp from the future kept its
    // place in all three for as long as it stood: first in every deck's scan at full
    // activity score, at the top of the other person's conversation list until they
    // replied, or below every reply anybody sent after it in the thread.
    //
    // A day of slack, because every stamp here comes from the writer's own clock and
    // a device running fast is not an attacker — refusing it would refuse its
    // messages. A day's lead is all a forged stamp can buy, and once real time passes
    // it, it ages like any other.
    //
    // `matches()` must match the whole string, so the pattern needs no anchors, and
    // the shape it allows is twenty-four characters, so this bounds the size stampOk
    // bounds as well. The pattern holds the time of day to 00:00:00..23:59:59, and
    // `timestamp.date` holds the date to the calendar: month 13, day 0 or February 29
    // of 2026 makes it fail, and a failed expression denies. The pattern has to do
    // its half, because the sum below does not: it counts an hour of 25 as one in the
    // morning of the next day, inside the ceiling, and `Date.parse` reads the same
    // string as no time at all — so the clients reading it would have held a stamp
    // they could not read.
    //
    // Used on `discovery`, `matches` and `messages`. Not on `users/{uid}`: every one
    // of the four stamps userDocOk checks would pay for it, out of an evaluation
    // budget that has none to spare (see below) — with all four held to it, the
    // costliest user document the store writes was refused before a single clause
    // of `08-budget`'s padding was added. Not on swipes or reports either,
    // whose stamps order only their own author's lists — the swipe history the data
    // export writes, the reports you have filed — so a forged one misleads only the
    // account that forged it.
    function currentStampOk(v) {
      return v is string
        && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z')
        && timestamp.date(int(v[0:4]), int(v[5:7]), int(v[8:10]))
             + duration.time(int(v[11:13]), int(v[14:16]), int(v[17:19]), 0)
           <= request.time + duration.value(1, 'd');
    }

    // A list's *contents*, not just how many elements it holds.
    //
    // `size()` bounds the count and says nothing about what is inside, so
    // `photos: ['x' repeated 300000]` satisfied every check in this file: one
    // element, comfortably under six. Same for `interests`, `blocked` and the
    // keys and values of `learning.interestAffinity`. `docs/DEPLOY.md` listed
    // exactly those as the size hole that could not be closed, on the grounds
    // that the rules language cannot iterate a list.
    //
    // It cannot. It does not need to: `join` concatenates a list into a string,
    // and a string can be measured. One expression bounds every element at once,
    // whatever the split between them — which is the property that matters,
    // because the ceiling being defended is the document's, not any one field's.
    // Non-strings are stringified rather than rejected, so a numeric list is
    // measured too, and an element that is a map or a list makes `join` fail,
    // which denies.
    function listCharsOk(v, cap) {
      return v.join('').size() <= cap;
    }

    // There are deliberately no strOk(v, cap) / numIn(v, lo, hi) helpers here, and
    // the repetition below is not an oversight.
    //
    // A rules request may evaluate at most 1000 expressions, and this file's user
    // document validator sits close enough to that ceiling that the margin is
    // measured by a test (`rules-tests/specs/08-budget.rules.js`). Folding the
    // repeated comparisons into helpers reads better and costs more: that spec
    // measures a clause that is a call — `stampOk(d.createdAt)` — at about 2.4
    // times a plain `d.uid is string`, where the same check written inline is
    // about 2.2, and prints both on every run. Wrapping every bound in one spent the
    // remaining margin and every user document write began failing, as a flat
    // `permission-denied` naming no field, which is how running out of budget
    // always looks. (A fifth of a clause per call is also why deleting a lone
    // pass-through wrapper buys clarity and no measurable budget: putting
    // `bookkeepingOk` back leaves the headroom exactly where it is.)
    //
    // `stampOk` and `listCharsOk` stay because each is called for a construct
    // there is no short way to write, and each earns its call.

    // ---------------------------------------------------------------------------
    // users/{uid} — the profile documents that power discovery
    // ---------------------------------------------------------------------------
    //
    // Readable and writable only by the owner, and written only in the exact shape the
    // app produces. Discovery scans candidates locally (the matching engine is
    // on-device), but it reads `discovery/{uid}`, the public projection below, not
    // these documents: see the read rule.
    match /users/{uid} {

      // profile.personality — five integer axes, 0..100, all optional.
      //
      // The key list is closed, and that is not symmetry for its own sake. This
      // validator named five keys and bounded neither the others nor how many there
      // were, so a personality map could carry ten thousand fields and pass; and the
      // projection copies `personality` across verbatim, so a private document the
      // rules accepted could produce a `discovery/{uid}` write they refused. The
      // projection write is best-effort by design — it must never fail the profile
      // save that caused it — so the account would save, silently stop publishing,
      // and vanish from every deck with nothing said. That is the `lastActiveAt: null`
      // failure exactly, and `store-tests/specs/04-rules-accept.store.js` now replays
      // a real projection against this file so it cannot happen quietly again.
      //
      // No `is map` and no `is number`, where the projection's copy has both. userDocOk
      // says why, and why this copy is not the weaker of the two.
      function personalityOk(pp) {
        return pp == null || (
          pp.keys().hasOnly(['openness', 'conscientiousness', 'extraversion',
                             'agreeableness', 'stability'])
          && (!('openness' in pp) || (pp.openness >= 0 && pp.openness <= 100))
          && (!('conscientiousness' in pp) || (pp.conscientiousness >= 0 && pp.conscientiousness <= 100))
          && (!('extraversion' in pp) || (pp.extraversion >= 0 && pp.extraversion <= 100))
          && (!('agreeableness' in pp) || (pp.agreeableness >= 0 && pp.agreeableness <= 100))
          && (!('stability' in pp) || (pp.stability >= 0 && pp.stability <= 100))
        );
      }

      // profile.location — either null or a real coordinate pair with a short label,
      // and nothing else beside them: the same closed list as the projection's copy.
      function locationOk(loc) {
        return loc == null || (
          loc.keys().hasOnly(['label', 'lat', 'lng'])
          && loc.lat >= -90 && loc.lat <= 90
          && loc.lng >= -180 && loc.lng <= 180
          && (!('label' in loc) || (loc.label is string && loc.label.size() <= 120))
        );
      }

      // profile.* — bounded bio, capped interest/photo lists, known gender values, and
      // no field the profile editor does not write.
      function profileOk(p) {
        return p.keys().hasOnly(['birthdate', 'age', 'gender', 'pronouns', 'bio', 'photos',
                                 'interests', 'personality', 'location', 'showAge', 'showDistance'])
          && (!('bio' in p) || (p.bio is string && p.bio.size() <= 500))
          // 12 slugs from a fixed vocabulary whose longest entry is 12 characters,
          // so 240 is nearly double what the editor can produce.
          && (!('interests' in p) || (p.interests is list && p.interests.size() <= 12
                                      && listCharsOk(p.interests, 240)))
          // 6 links at 1024 characters each, which is what the profile editor
          // now enforces one at a time so the refusal is visible there rather
          // than arriving as an unexplained permission-denied on save.
          && (!('photos' in p) || (p.photos is list && p.photos.size() <= 6
                                   && listCharsOk(p.photos, 6144)))
          && (!('gender' in p) || (p.gender in ['woman', 'man', 'nonbinary', 'other']))
          && (!('pronouns' in p) || (p.pronouns is string && p.pronouns.size() <= 40))
          && (!('birthdate' in p) || (p.birthdate == null || (p.birthdate is string && p.birthdate.size() == 10)))
          && (!('age' in p) || p.age == null || (p.age is number && p.age >= 18 && p.age <= 120))
          && (!('showAge' in p) || (p.showAge is bool))
          && (!('showDistance' in p) || (p.showDistance is bool))
          && (!('personality' in p) || personalityOk(p.personality))
          && (!('location' in p) || locationOk(p.location));
      }

      // preferences.* — the mutual filters. Age window must stay inside 18..100 and
      // ordered, distance inside 1..500 km (500 means "anywhere").
      function prefsOk(f) {
        return f.keys().hasOnly(['interestedIn', 'ageMin', 'ageMax', 'maxDistanceKm', 'notifications',
                                 'theme', 'discoverable'])
          && (!('ageMin' in f) || (f.ageMin >= 18 && f.ageMin <= 100))
          && (!('ageMax' in f) || (f.ageMax >= 18 && f.ageMax <= 100))
          && (!(('ageMin' in f) && ('ageMax' in f)) || f.ageMin <= f.ageMax)
          && (!('maxDistanceKm' in f) || (f.maxDistanceKm >= 1 && f.maxDistanceKm <= 500))
          // Four elements, and each one of the same four words `profile.gender` allows.
          //
          // BOTH bounds, and the reason is a regression this file shipped with for one
          // round. `size() <= 4` was replaced by `hasOnly([...])` alone, on the reasoning
          // that naming the values "bounds both, in one clause rather than two". It does
          // not. `hasOnly` is a subset test over element VALUES and says nothing about how
          // many there are, and duplicates satisfy it — so `['woman']` twenty thousand
          // times passed, 157 KiB in the one collection every signed-in account downloads
          // to build a deck. Measured against the emulator, not reasoned about.
          // No `is list`, because no non-list can satisfy both halves. `.hasOnly()`
          // exists only on a list, so it raises on anything else and a raised
          // expression denies; `.size()` catches numbers and booleans before that,
          // raising on them too. Note what `.size()` does NOT do: strings and maps
          // have one, so it type-checks nothing on its own — a short string clears
          // the length bound and is refused by `hasOnly` alone. Written the other way
          // round at first ("both raise on anything that is not one"), which is false
          // for exactly those two, and the specs cited here were choosing fixtures
          // long enough that the length bound refused them before the type ever
          // mattered. `01-users` and `02-discovery` now use short ones.
          && (!('interestedIn' in f) || (f.interestedIn.size() <= 4
                                         && f.interestedIn.hasOnly(['woman', 'man', 'nonbinary', 'other'])))
          && (!('theme' in f) || (f.theme in ['system', 'light', 'dark']))
          && (!('notifications' in f) || (f.notifications is bool))
          && (!('discoverable' in f) || f.discoverable is bool);
      }

      // learning.* and usage.* — small bookkeeping maps; keep the counters sane so the
      // document cannot be grown without bound.
      //
      // Each sub-map is passed into its own function rather than reached through
      // `d.learning.likeCount` at every mention. That is not tidiness: a rules
      // request may evaluate at most 1000 expressions, every step of a path is
      // one of them, and this validator walks the same three-deep paths two and
      // three times per clause. `rules-tests/specs/08-budget.rules.js` measures
      // what is left of that allowance.

      // learning.interestAffinity — interest slugs mapped to weights the engine
      // has already clamped to -1..1 and rounded to four places. Both sides are
      // measured: a key list capped at 60 bounded neither the slugs nor what they
      // mapped to, and one value could be a megabyte-long string under the name
      // `hiking`.
      function affinityOk(m) {
        return m.keys().size() <= 60
          && listCharsOk(m.keys(), 1200)
          && listCharsOk(m.values(), 1500);
      }

      function learningOk(l) {
        return l.keys().hasOnly(['interestAffinity', 'likeCount', 'passCount'])
          && (!('interestAffinity' in l) || affinityOk(l.interestAffinity))
          && (!('likeCount' in l) || l.likeCount >= 0)
          && (!('passCount' in l) || l.passCount >= 0);
      }

      function usageOk(u) {
        return u.keys().hasOnly(['date', 'likes', 'superLikes', 'rewinds'])
          && (!('date' in u) || (u.date is string && u.date.size() == 10))
          && (!('likes' in u) || u.likes >= 0)
          && (!('superLikes' in u) || u.superLikes >= 0)
          && (!('rewinds' in u) || u.rewinds >= 0);
      }

      // The whole UserDoc: a closed top-level key list and every nested validator.
      // `createdAt` has to be present, which the unconditional `stampOk(d.createdAt)` a
      // few lines down is what guarantees: the immutability check below requires it
      // unchanged on both sides of every update, so a document without one could never
      // be updated at all.
      //
      // Closed rather than merely complete: `hasAll` says the required keys are there and
      // nothing about the rest, so an account could pad its own document to the 1 MiB
      // ceiling with fields no part of this app reads. That is a smaller lever than the
      // swipe collection — one document per account rather than one per swipe — but it is
      // the same lever, and there is no reason to leave it. The list is the fourteen keys
      // the store's own DEFAULT_USER carries, and tests/projection.test.js compares the
      // two so neither can drift without the other.
      //
      // Closed at every level, and for a while it was not. This list closed the top level,
      // and of the maps under it only `profile.personality` closed its own: profileOk,
      // prefsOk, learningOk, usageOk and the private locationOk each tested the keys they
      // named and let any other key through, so `profile.padding` carried whatever the
      // ceiling would hold while this comment said the lever was shut. Each closes its own
      // list now, and tests/projection.test.js compares every one with what the client
      // writes into that map: DEFAULT_USER's maps for the first four (and for
      // personalityOk's list), and for the last, the location the profile editor's
      // buildPatch builds, since DEFAULT_USER's is null.
      //
      // That cost evaluation budget this validator did not have. With every type test left
      // where it was, closing them put every write of the document
      // `rules-tests/specs/08-budget.rules.js` measures (every optional field set, a
      // location among them) over the limit, down to creating it as a free account. The
      // same document without the location still fitted, but updating it as a premium one,
      // with identityUnchanged() as it then was, had a single clause to spare. And
      // 08-budget, which measures creating and updating that document as a premium account
      // (the costliest the store writes), had found the update ALREADY over before
      // anything was closed. It was bought back without loosening anything. The validators
      // of the maps under this one no longer open with `is map`, because `keys()` exists
      // only on a map; and the counters and ranges of preferences, learning, usage,
      // location and personality no longer say `is number`, because comparing anything
      // that is not a number with a number denies. Each of those type tests repeated what
      // the operation after it enforces anyway. (Measured against the emulator for a
      // string, a numeric string, a boolean, null, a list, a map and a timestamp, not
      // reasoned about; `01-users` writes a list where each map belongs and a string into
      // each counter, and both are refused as before. `profile.age` keeps its `is number`
      // because tests/limits.test.js reads that clause whole, in both copies, to compare
      // the editor's oldest age with the rules'.) The projection's copies of personalityOk
      // and locationOk keep their type tests, because nothing there is near the limit; the
      // two copies accept exactly the same values. `identityUnchanged()` below is the
      // other half of what was bought back.
      function userDocOk(d) {
        return d.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt',
                                 'lastActiveAt', 'profileComplete', 'plan', 'planSince',
                                 'profile', 'preferences', 'learning', 'usage', 'blocked'])
          // Two checks that used to be here are gone, and both were redundant
          // rather than relaxed — this rule has an expression budget to answer to
          // (`rules-tests/specs/08-budget.rules.js`), and a check that says nothing
          // new is the first thing to spend.
          //
          // A `hasAll` naming seven required keys. Six of them — email, displayName,
          // createdAt, plan, profile, preferences — are dereferenced unconditionally
          // in the lines below, and reading a key a map does not have is an error
          // that denies the write. The seventh, `uid`, is not dereferenced here at
          // all any more (see the next paragraph); it is the `allow` rules that
          // reach for it, and they deny for the same reason. `01-users` removes each
          // of the seven in turn and confirms the write still fails, which is the
          // claim that matters — this paragraph only says where each denial comes
          // from, and it said "every one of them" while one of them was elsewhere.
          //
          // `d.uid is string`: create requires `request.resource.data.uid == uid`,
          // which is the document id and therefore a string, and update freezes it
          // against the stored value. Neither path could reach this line without it.
          && d.email is string && d.email.size() <= 320
          && d.displayName is string && d.displayName.size() <= 60
          && d.plan in ['free', 'premium']
          && (!('planSince' in d) || (d.planSince == null || stampOk(d.planSince)))
          && (!('profileComplete' in d) || (d.profileComplete is bool))
          && stampOk(d.createdAt)
          && (!('updatedAt' in d) || stampOk(d.updatedAt))
          // null is how the store spells "never active", exactly as it spells an
          // unset planSince above. Requiring a string here rejected any user
          // document created through updateUser's upsert path — the shape the
          // store has always written, and the demo adapter accepts.
          && (!('lastActiveAt' in d) || (d.lastActiveAt == null || stampOk(d.lastActiveAt)))
          && profileOk(d.profile)
          && prefsOk(d.preferences)
          // These three were behind a `bookkeepingOk(d)` wrapper that did nothing but
          // forward them. Removing it bought no measurable budget — a call's own
          // overhead is about a fifth of a clause (see the note above `users/{uid}`) —
          // only one hop less to follow when reading what a user document may contain.
          && (!('learning' in d) || learningOk(d.learning))
          && (!('usage' in d) || usageOk(d.usage))
          // 1000 uids at 48 characters each. A Firebase Auth uid is 28.
          && (!('blocked' in d) || (d.blocked is list && d.blocked.size() <= 1000
                                    && listCharsOk(d.blocked, 48000)));
      }

      // Identity fields are set at sign-up, and uid and createdAt can never be rewritten
      // afterwards — this is what stops an account from impersonating another or
      // back-dating itself. email has one way through, and only one: to the address
      // Firebase Auth signed into the caller's own ID token, which a client cannot forge.
      // That corrects the stored copy of the account's identity rather than changing it.
      // auth.js asks for exactly that on any page load where the two differ, and while
      // email was frozen outright every such write was refused: a document whose address
      // was stored as '' (updateUser's upsert used to write that) or changed outside the
      // app kept it for good, and the refusal sent a finished account back through
      // onboarding on every page. A token carrying no email cannot satisfy the comparison;
      // `01-users` signs in with none and is still refused.
      //
      // One question asked of the diff rather than three `==`s, and that is budget, not
      // style. Every routine write to this document is an update — the last-active stamp
      // as pages load (at most every five minutes), the learning map on every swipe, the
      // usage counter on every like — so this runs on top of userDocOk on the writes that
      // cost the most. Measured on that path with `08-budget`'s clause as the unit: the
      // three comparisons, walking six request and resource paths, cost five; one `hasAll`
      // of the diff cost two. Binding the diff to `same`, so the email question reuses it,
      // costs one more there (08-budget's update headroom went from 13 to 12), and the
      // correction, which also reads the token, is two behind that (10); 08-budget measures
      // all three paths. `unchangedKeys()` holds a key only when both versions have it with
      // equal values, so `hasAll` and `in` ask what the `==`s did, a missing field included
      // — and `01-users` still rewrites each of the three and is refused.
      function identityUnchanged() {
        let same = request.resource.data.diff(resource.data).unchangedKeys();
        return same.hasAll(['uid', 'createdAt'])
          && ('email' in same || request.resource.data.email == request.auth.token.email);
      }

      // Owner only. Other people are discovered through discovery/{uid}, a
      // projection holding just the public fields — email, birthdate, block
      // lists, usage counters and learned affinities never leave the account.
      allow read: if isOwner(uid);

      // Create: only your own document, and the embedded uid must match the doc id.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && userDocOk(request.resource.data);

      // Update: only your own document, shape re-validated, identity fields frozen (email
      // may only be corrected to the caller's own; see identityUnchanged).
      allow update: if isOwner(uid)
        && userDocOk(request.resource.data)
        && identityUnchanged();

      // Delete: account deletion, owner only.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------------
    // discovery/{uid} — the public projection of a profile
    // ---------------------------------------------------------------------------
    //
    // The on-device matching engine needs to scan other people's profiles, so this
    // collection is readable by any signed-in user (every projection that is
    // discoverable; see the read rule) — and therefore it may contain ONLY fields
    // meant for other users. `hasOnly` guarantees a tampered client
    // cannot smuggle private fields (email, birthdate, blocked, learning, usage)
    // into the readable copy. The app writes it as a mirror of users/{uid} on
    // every profile save, with coordinates rounded to ~1 km.
    match /discovery/{uid} {

      // The public subset of profile.* — same bounds as the private doc, but the
      // key list is closed: no birthdate here, only the derived age.
      function discoveryProfileOk(p) {
        return p is map
          && p.keys().hasOnly(['age', 'gender', 'pronouns', 'bio', 'photos', 'interests',
                               'personality', 'location', 'showAge', 'showDistance'])
          && (!('bio' in p) || (p.bio is string && p.bio.size() <= 500))
          // The vocabulary the profile editor offers, which seed-data.js publishes as
          // ZC.INTEREST_TAGS; tests/limits.test.js holds this list to that one.
          //
          // Tighter than the private document's character total, and the reason is
          // what other people's clients do with this copy. Whoever swipes a card
          // copies its interests into the learning map in their OWN private document,
          // and `affinityOk` holds that map to 1200 key characters. Five accounts with
          // one 239-character tag each — every one inside the 240-character total this
          // copy used to share with the private one — filled 1195 of them. From then
          // on a save of the swiper's map that learned any slug longer than five
          // characters (42 of the 48), or two new tags at once, was refused, page
          // load after page load. A tag named `__x__` took one card to make every
          // save of the map fail for the rest of the page's session, because
          // Firestore will not store a field name that begins and ends with two
          // underscores. Another account's profile must not be able to stop yours
          // from saving. `hasOnly` does not refuse repeats, so the most twelve
          // entries can hold is twelve copies of the longest slug, 144 characters:
          // the vocabulary bounds the contents more tightly than that total did,
          // and it is not repeated here.
          && (!('interests' in p) || (p.interests is list && p.interests.size() <= 12
                                      && p.interests.hasOnly([
                                        'hiking', 'camping', 'climbing', 'kayaking', 'birding',
                                        'painting', 'photography', 'film', 'poetry', 'theatre',
                                        'cooking', 'baking', 'coffee', 'wine', 'street-food',
                                        'live-music', 'vinyl', 'guitar', 'jazz', 'electronic',
                                        'running', 'yoga', 'cycling', 'lifting', 'swimming',
                                        'coding', 'gaming', 'robotics', 'astronomy', 'tinkering',
                                        'road-trips', 'backpacking', 'languages', 'city-breaks',
                                        'train-travel',
                                        'reading', 'gardening', 'board-games', 'knitting', 'puzzles',
                                        'dancing', 'karaoke', 'volunteering', 'trivia',
                                        'meditation', 'journaling', 'philosophy', 'tea'])))
          && (!('photos' in p) || (p.photos is list && p.photos.size() <= 6
                                   && listCharsOk(p.photos, 6144)))
          && (!('gender' in p) || (p.gender in ['woman', 'man', 'nonbinary', 'other']))
          && (!('pronouns' in p) || (p.pronouns is string && p.pronouns.size() <= 40))
          && (!('age' in p) || p.age == null || (p.age is number && p.age >= 18 && p.age <= 120))
          && (!('showAge' in p) || (p.showAge is bool))
          && (!('showDistance' in p) || (p.showDistance is bool))
          // `location` and `personality` were both on the key list above with no
          // validator at all, so the one public collection in the project
          // accepted a megabyte under either name. Every signed-in user reads these
          // documents to build a deck. `location` was found by eye a few rounds ago;
          // `personality` outlived that pass, and was found by asking the question
          // mechanically instead — tests/limits.test.js now checks that every key an
          // allowlist admits is one something in the same validator looks at.
          && (!('location' in p) || locationOk(p.location))
          && (!('personality' in p) || personalityOk(p.personality));
      }

      // Restated rather than shared: a rules function does not cross a `match` block,
      // and the private document's copy is nearly three hundred lines and one collection
      // away. Same five axes, same range, and the same closed key list — the private copy
      // has one too (`pp.keys().hasOnly([...])`, in its own `personalityOk`), which this
      // comment used to deny. Both close the list for the same reason: an extra axis is a
      // field the engine would never read and the 1 MiB ceiling would happily carry. This
      // copy and the location one below keep `is map` and `is number` where the private
      // copies leave both to `keys()` and the comparisons; userDocOk says why, and the
      // two accept exactly the same values.
      function personalityOk(pp) {
        return pp == null || (
          pp is map
          && pp.keys().hasOnly(['openness', 'conscientiousness', 'extraversion',
                                'agreeableness', 'stability'])
          && (!('openness' in pp) || (pp.openness is number && pp.openness >= 0 && pp.openness <= 100))
          && (!('conscientiousness' in pp) || (pp.conscientiousness is number && pp.conscientiousness >= 0 && pp.conscientiousness <= 100))
          && (!('extraversion' in pp) || (pp.extraversion is number && pp.extraversion >= 0 && pp.extraversion <= 100))
          && (!('agreeableness' in pp) || (pp.agreeableness is number && pp.agreeableness >= 0 && pp.agreeableness <= 100))
          && (!('stability' in pp) || (pp.stability is number && pp.stability >= 0 && pp.stability <= 100))
        );
      }

      // Either null or a real coordinate pair with a short label. Same shape the private
      // document is held to; stated again because rules functions do not cross a match
      // block, and a projection that drifted from the original is the failure this file
      // has already had once.
      function locationOk(loc) {
        return loc == null || (
          loc is map
          && loc.keys().hasOnly(['label', 'lat', 'lng'])
          && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
          && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
          && (!('label' in loc) || (loc.label is string && loc.label.size() <= 120))
        );
      }

      // The public subset of preferences.* — just the mutual discovery filters.
      function discoveryPrefsOk(f) {
        return f is map
          && f.keys().hasOnly(['interestedIn', 'ageMin', 'ageMax', 'maxDistanceKm', 'discoverable'])
          && (!('ageMin' in f) || (f.ageMin is number && f.ageMin >= 18 && f.ageMin <= 100))
          && (!('ageMax' in f) || (f.ageMax is number && f.ageMax >= 18 && f.ageMax <= 100))
          && (!('maxDistanceKm' in f) || (f.maxDistanceKm is number && f.maxDistanceKm >= 1 && f.maxDistanceKm <= 500))
          // Both bounds here too, and this is the copy that matters — see the note on
          // prefsOk. A list bounded only by `hasOnly` is unbounded in length.
          // No `is list`, because no non-list can satisfy both halves. `.hasOnly()`
          // exists only on a list, so it raises on anything else and a raised
          // expression denies; `.size()` catches numbers and booleans before that,
          // raising on them too. Note what `.size()` does NOT do: strings and maps
          // have one, so it type-checks nothing on its own — a short string clears
          // the length bound and is refused by `hasOnly` alone. Written the other way
          // round at first ("both raise on anything that is not one"), which is false
          // for exactly those two, and the specs cited here were choosing fixtures
          // long enough that the length bound refused them before the type ever
          // mattered. `01-users` and `02-discovery` now use short ones.
          && (!('interestedIn' in f) || (f.interestedIn.size() <= 4
                                         && f.interestedIn.hasOnly(['woman', 'man', 'nonbinary', 'other'])))
          && (!('discoverable' in f) || f.discoverable is bool);
      }

      // The whole projection: a closed key list at the top level too.
      function discoveryOk(d) {
        return d.keys().hasOnly(['uid', 'displayName', 'profileComplete', 'lastActiveAt',
                                 'profile', 'preferences'])
          && d.uid == uid
          && d.displayName is string && d.displayName.size() <= 60
          && (!('profileComplete' in d) || (d.profileComplete is bool))
          // Held to the clock and not only to a size: see currentStampOk. The private
          // document's copy is not (userDocOk has no budget for it), which is why
          // `projectDiscovery` never publishes a stamp later than the moment it runs.
          && (!('lastActiveAt' in d) || currentStampOk(d.lastActiveAt))
          && (!('profile' in d) || discoveryProfileOk(d.profile))
          && (!('preferences' in d) || discoveryPrefsOk(d.preferences));
      }

      // Read: any signed-in user while the projection is discoverable — this is the
      // discovery surface. Turned off, it is readable only by the accounts that
      // already know the person.
      //
      // "Show me in other people's decks" used to be honoured by the client alone:
      // the deck query asks for `discoverable == true` and the engine hard-fails the
      // rest, while this rule said `isSignedIn()`. So the switch hid nobody from
      // anybody who asked, and `where('preferences.discoverable', '==', false)`
      // returned exactly the people who had asked to disappear — bio, photos,
      // approximate location — as a list.
      //
      // A paused projection stays readable to its owner and to the accounts that
      // already know the person, and to nobody else: a match, whose conversation is
      // drawn with this face (settings.html promises "Your existing matches and
      // conversations stay exactly where they are"), and somebody it liked, whose
      // who-liked-you list reads the face of everybody still waiting. Neither is
      // something the reader can make alone: a match is written only once the
      // other person has liked you, and a swipe only by its author. The like is
      // asked by its action, not by whether the swipe exists: otherwise a paused
      // profile you could read and that is not among your likes would be a pass,
      // which the swipes rule below keeps private to its author. A miss is an
      // empty snapshot, as it has always been, because fetchProfiles asks about
      // accounts that may since have been deleted.
      //
      // Somebody who reported the person is not on that list, though the settings
      // page names each report. Anybody signed in may file a report about any
      // published account and withdraw it again, so a read it opened would be one a
      // stranger holding the uid could grant themselves, use and retract, leaving
      // nothing in the queue. The report menu is in a conversation, so a reporter
      // is a match; unmatching deletes the match and leaves the like under it, and
      // the like keeps the name. A report the page cannot read it names "a deleted
      // account", as it names one it cannot fetch.
      //
      // The rules are not a filter, so a query is allowed only when every document
      // it could return is: the deck's query names `discoverable == true` and is,
      // and a query that does not name it is refused whole. Each of the last two
      // clauses is a billed document read, so they come after every free one and in
      // the order the app needs them: a discoverable profile costs what it always
      // did, and only a paused one read by somebody other than its owner pays more —
      // up to two reads, when neither holds.
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.preferences.discoverable == true
            || isOwner(uid)
            || exists(/databases/$(database)/documents/matches/$(uid < request.auth.uid
                 ? uid + '_' + request.auth.uid : request.auth.uid + '_' + uid))
            || get(/databases/$(database)/documents/swipes/$(uid + '_' + request.auth.uid))
                 .data.action in ['like', 'super']);

      // Write: only your own projection, only in the public shape. The partial
      // lastActiveAt refresh must also stay inside the closed key list.
      allow create: if isOwner(uid) && discoveryOk(request.resource.data);
      allow update: if isOwner(uid) && discoveryOk(request.resource.data);

      // Delete: account deletion, owner only.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------------------
    // swipes/{swipeId} — one document per (from, to) decision, id is `from_to`
    // ---------------------------------------------------------------------------
    match /swipes/{swipeId} {

      // A swipe is a tiny immutable record; the doc id encodes both parties so a client
      // cannot create two conflicting swipes for the same pair.
      //
      // `hasOnly`, not `hasAll`. `hasAll` says the required keys are present and says
      // nothing about the rest, so a swipe could carry any number of extra fields and be
      // padded to the 1 MiB document ceiling. Nothing about this record is worth a
      // megabyte, and this is the cheapest such write in the project: creating one needs
      // only a signed-in account and a uid, and uids are enumerable from the
      // discovery collection the deck lists. A Spark project gets 1 GiB of storage, which
      // is a thousand documents at that size — and the daily swipe limit that would
      // otherwise slow it down is enforced in the browser, so it does not apply to a
      // client that has stopped cooperating. Bounding the shape is what bounds the write.
      function swipeOk(d) {
        return d.keys().hasOnly(['id', 'from', 'to', 'action', 'createdAt'])
          && d.keys().hasAll(['from', 'to', 'action', 'createdAt'])
          && d.from is string && d.from.size() > 0
          && d.to is string && d.to.size() > 0
          && d.from != d.to
          && d.action in ['like', 'pass', 'super']
          && stampOk(d.createdAt)
          && (!('id' in d) || (d.id == swipeId))
          && swipeId == d.from + '_' + d.to;
      }

      // Read: the swipes you made, plus the likes and super likes aimed at you — those
      // are required for match detection and for the premium "who liked you" list.
      // No one else's, and no pass aimed at you.
      //
      // Inbound passes used to be readable as well, because the rule allowed every
      // document with `to == you`, and neither reason above needs one: a match needs
      // the other person's like, and the list is likes. A pass is the one decision
      // somebody makes about you that the app never shows you, and a single query
      // listed every account that had passed on you, with the time.
      //
      // `resource` is null when the requested document does not exist, and dereferencing
      // it would raise an evaluation error (surfacing to the client as PERMISSION_DENIED
      // rather than an empty snapshot). The client reads absent documents constantly:
      // every first swipe reads its own not-yet-written record, and `getLikesReceived`
      // asks, once per person who liked you, whether `swipes/{me}_{them}` exists. So a
      // miss of a swipe you would have made has to be an allowed read that reports
      // `exists == false`.
      //
      // A miss of a swipe aimed at you is refused, and that is what keeps a pass
      // private. Were it answered, a refusal would mean "this exists and is a pass" and
      // an empty snapshot "nobody has swiped", so the denial itself would be the pass.
      // Refused alike, they say the one thing both mean to the client: they have not
      // liked you. recordSwipe and finishMatchCheck read the reciprocal swipe that way.
      //
      // Which miss, though, is the whole question. This used to be a bare
      // `resource == null`, allowing every signed-in caller to read every absent
      // document — and that is an existence oracle rather than nothing, because the
      // answers differ: an empty snapshot means the document is not there, a denial
      // means it is there and is not yours. Anyone could therefore learn that Alice has
      // swiped on Bob, for any pair, without reading a byte of it — and uids are
      // enumerable, since any signed-in user can list every discoverable projection in
      // `discovery/{uid}` and its document id is the uid. The reports rule below
      // already refuses misses for exactly this reason and says so; these two
      // disagreed with it.
      //
      // The id is `from_to`, so the pair is in the name: a caller may probe a miss only
      // when they are its first half, the author it would have had. That is precisely
      // what the client asks about, and a uid is never a prefix match — the id is split
      // and its first element compared whole — so a uid that somehow contained an
      // underscore would be denied rather than admitted.
      allow read: if isSignedIn()
        && (resource == null
              ? swipeId.split('_')[0] == request.auth.uid
              : (resource.data.from == request.auth.uid
                 || (resource.data.to == request.auth.uid
                     && resource.data.action in ['like', 'super'])));

      // Create: you may only record swipes authored by yourself.
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && swipeOk(request.resource.data);

      // Never editable — a rewind deletes and re-creates instead.
      allow update: if false;

      // Delete: your own swipe, whatever it says (the rewind path), or a like or a
      // super like aimed at you — an inbound like is data about you, and account
      // deletion must be able to purge it.
      //
      // Not a pass aimed at you. Account deletion never queries for one, because a pass
      // is not yours to read, and deleting one is not harmless: the id is `from_to`,
      // so the person passed on knows it, and the deck leaves out everybody its
      // author has a swipe for, so a pass deleted is that person back in the deck.
      // This rule used to allow every swipe with `to == you`, and with it exactly that.
      //
      // And a swipe that is already gone: `resource` is null for a missing document,
      // and this rule dereferenced it. undoSwipe deletes inside a transaction without
      // reading the swipe first, so rewinding a card whose swipe was already removed —
      // a second tab on the same deck, or a retry — came back permission-denied in
      // Firebase mode, where the demo adapter answers `{ ok: true }` and
      // tests/data-store.test.js pins that as the contract. Deleting nothing changes
      // nothing, and it is allowed by the id rather than unconditionally, to the
      // author alone — the same half the read rule lets probe a miss. Either half was
      // allowed while either could delete the swipe that was there, and that stopped
      // being safe when the target lost the pass: with a miss allowed to the target and
      // a pass refused, the refusal would mean "this is a pass", which is the oracle the
      // read rule refuses a miss aimed at you to deny. Refused alike, a missing swipe
      // and a pass both tell the target only that there is no like to delete. A
      // stranger is refused for a missing swipe exactly as for a present one.
      //
      // So the condition is now the read rule's, word for word: you may delete what
      // you may read. A liker who rewinds while account deletion is purging their
      // like turns it into one of the refused cases mid-batch; deleteAccountData
      // asks again, once, rather than failing, and store-tests/specs/07-deletion
      // runs that race.
      allow delete: if isSignedIn()
        && (resource == null
              ? swipeId.split('_')[0] == request.auth.uid
              : (resource.data.from == request.auth.uid
                 || (resource.data.to == request.auth.uid
                     && resource.data.action in ['like', 'super'])));
    }

    // ---------------------------------------------------------------------------
    // matches/{matchId} — id is the two uids sorted and joined with '_'
    // ---------------------------------------------------------------------------
    match /matches/{matchId} {

      // Exactly two participants, sorted, and the doc id derived from them. The caller
      // must be one of them, so nobody can invent a match between two other people.
      // `before` is the unread map already stored, and empty for a create.
      function matchOk(d, before) {
        return d.keys().hasOnly(['id', 'users', 'createdAt', 'lastMessage', 'lastMessageAt', 'unread'])
          && d.keys().hasAll(['users', 'createdAt'])
          && d.users is list
          && d.users.size() == 2
          && d.users[0] is string
          && d.users[1] is string
          && d.users[0] < d.users[1]
          && matchId == d.users[0] + '_' + d.users[1]
          && request.auth.uid in d.users
          && (!('id' in d) || (d.id == matchId))
          // Both stamps order the other person's conversation list, and an update may
          // rewrite either one, so both are held to the clock: see currentStampOk.
          && currentStampOk(d.createdAt)
          && (!('lastMessage' in d) || (d.lastMessage == null || (d.lastMessage is string && d.lastMessage.size() <= 1000)))
          && (!('lastMessageAt' in d) || (d.lastMessageAt == null || currentStampOk(d.lastMessageAt)))
          // The unread map may be keyed only by the two participants, and each count is
          // a whole number. `keys().size() <= 2` bounded the count of keys and neither
          // their names nor their values, so two megabyte strings passed it; and
          // `is number && >= 0` let Infinity through, which the other side's badge
          // printed as "Infinity unread". The store writes 0 when a thread is read and
          // adds 1 per message, so its counts are integers. A million is a ceiling no
          // conversation reaches: a message is two writes, so it is a hundred days of
          // a Spark project's whole 20,000-write allowance spent on one person's inbox.
          //
          // The ceiling binds a count somebody writes, not one the other person's
          // messages raise. Each send adds one with `FieldValue.increment(1)`, which
          // lands one past whatever is stored, and with a bound on the value alone a
          // participant who parked their own count at the ceiling turned every message
          // the other person sent into a refused preview update. One past the stored
          // count is always allowed, so no count either of them can write stops the
          // other's next message, and the only way past the ceiling is one at a time.
          && (!('unread' in d) || (
            d.unread is map
            && d.unread.keys().hasOnly(d.users)
            && countOk(d.unread, before, d.users[0])
            && countOk(d.unread, before, d.users[1])
          ));
      }

      // One participant's unread count: a whole number, no more than the ceiling or no
      // more than one past the count stored before this write. See matchOk.
      function countOk(unread, before, u) {
        return !(u in unread)
          || (unread[u] is int && unread[u] >= 0
              && (unread[u] <= 1000000 || unread[u] <= before.get(u, 0) + 1));
      }

      // The other side of a match document, from the caller's point of view.
      function otherOf(d) {
        return d.users[0] == request.auth.uid ? d.users[1] : d.users[0];
      }

      // The swipe the other person aimed at the caller — `swipes/{other}_{me}`.
      function inboundSwipe(d) {
        return /databases/$(database)/documents/swipes/$(otherOf(d) + '_' + request.auth.uid);
      }

      // True only when that person has actually liked (or super-liked) the caller, which
      // is exactly the condition recordSwipe checks client-side before writing a match.
      function likedByOther(d) {
        return exists(inboundSwipe(d))
          && get(inboundSwipe(d)).data.action in ['like', 'super'];
      }

      // Whether `owner` has blocked `subject`.
      //
      // A block list lives in the owner's private `users/{uid}` document, which no other
      // client may read — deliberately, since publishing who you have blocked is its own
      // disclosure. A rule may read it: `get()` is evaluated server-side and is not itself
      // subject to the read rules. That makes this the only place in a project with no
      // server where a block can be *enforced* rather than merely honoured by a
      // cooperating client, and a blocked account is exactly the one whose client should
      // not be trusted to cooperate.
      //
      // `get('blocked', [])` rather than a membership test on the key, so an account
      // written before that field existed reads as blocking nobody instead of erroring.
      function hasBlocked(owner, subject) {
        return exists(/databases/$(database)/documents/users/$(owner))
          && subject in get(/databases/$(database)/documents/users/$(owner)).data.get('blocked', []);
      }

      // Read: participants only. As with swipes, a read of a document that does not exist
      // has `resource == null` and dereferencing it errors instead of returning an empty
      // snapshot — and rewind probes the (usually absent) match document for the pair on
      // every undo, inside a transaction, so that miss has to be allowed.
      //
      // Allowed by the id, not unconditionally, for the reason spelled out on the swipes
      // rule above: a bare `resource == null` answers every caller for every id, and the
      // difference between an empty snapshot and a denial tells them whether two people
      // they named have matched. That is a more sensitive fact than a swipe. The id is
      // the sorted pair, so a caller may probe only a match they would be in.
      allow read: if isSignedIn()
        && (resource == null
              ? request.auth.uid in matchId.split('_')
              : request.auth.uid in resource.data.users);

      // Create: a participant creating a well-formed match document, but only once the
      // other person has actually liked them back. Without that proof any signed-in user
      // could mint a match against a uid read out of `discovery/{uid}` — which IS
      // deliberately open to any signed-in account while the person is discoverable,
      // and whose document id is the uid — and then message a stranger, since message
      // writes are gated purely on membership of the match. (This used to say "the
      // deliberately open users read". There is no such thing: `users/{uid}` is
      // `allow read: if isOwner(uid)`, as the comment above that rule says and
      // `rules-tests/specs/01-users.rules.js` asserts. The enumerable surface the
      // argument needs is the projection, which the swipes rule below names
      // correctly.) The client already satisfies this: recordSwipe writes
      // the swipe and only then, as a separate operation, creates the match — and so does
      // the quieter second caller, `finishMatchCheck`, which finishes a check a page load
      // lost. It reads the swipe back before creating anything, precisely because this
      // rule proves the OTHER person liked you and never looks at your own side.
      //
      // ...and not once they have blocked you. Unmatching alone is not durable: it deletes
      // the match document but not the like underneath it, so `likedByOther` still holds
      // and the other side can simply write the document again and carry on messaging.
      // The report dialog's "Block and unmatch" is the flow that has to survive that, and
      // this is what makes it survive.
      //
      // Only that direction is checked. "I blocked them" is enforced by my own client,
      // and a tampered client that matched somebody it had itself blocked would only be
      // reaching a person who liked it and has not blocked it back — self-inflicted, not
      // a safety failure — while checking it would double the document reads this rule
      // spends, against a hard limit of ten per request that `likedByOther` already uses
      // two of.
      allow create: if isSignedIn()
        && matchOk(request.resource.data, {})
        && likedByOther(request.resource.data)
        && !hasBlocked(otherOf(request.resource.data), request.auth.uid);

      // Update: participants only, for lastMessage / lastMessageAt / unread counters.
      // The participant list itself is frozen.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && matchOk(request.resource.data, resource.data.get('unread', {}));

      // Delete: unmatching, by either participant.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;

      // -------------------------------------------------------------------------
      // matches/{matchId}/messages/{msgId} — chat, append-only
      // -------------------------------------------------------------------------
      match /messages/{msgId} {

        // Read: participants of the parent match.
        allow read: if isParticipant(matchId);

        // Create: a participant, writing as themselves, with 1..1000 chars of text.
        // The 1000-character cap bounds `text` and, with `hasAll`, bounded nothing else:
        // the document could carry any other field at any size, so a capped message could
        // still be a megabyte. Closing the key list is what makes the cap mean what it
        // reads as.
        allow create: if isParticipant(matchId)
          && request.resource.data.keys().hasOnly(['id', 'from', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['from', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && (!('id' in request.resource.data) || request.resource.data.id == msgId)
          // Both sides' threads are ordered by this, so it is held to the clock as
          // well as to a size: see currentStampOk.
          && currentStampOk(request.resource.data.createdAt);

        // Messages are never edited, so neither side can rewrite what was said.
        // Deletes are allowed to participants because unmatch and account
        // deletion must purge the conversation before removing the parent match
        // (a deleted match would strand its messages forever, unreadable but
        // undeletable). The trade-off is deliberate: participants can remove
        // messages, nobody can alter them.
        allow update: if false;
        allow delete: if isParticipant(matchId);
      }
    }

    // ---------------------------------------------------------------------------
    // reports/{reportId} — the abuse-report queue, id is `from_about`
    // ---------------------------------------------------------------------------
    //
    // Anyone signed in can file a report about another account. The deterministic
    // id bounds the queue — one report per (reporter, subject) pair, so a single
    // account cannot flood the queue or burn the write quota with random ids —
    // and the subject must actually exist — in discovery, or as the reporter's
    // match — so reports cannot be filed against invented uids. Reports are
    // invisible to everyone except their own author: the reported party can never
    // enumerate, alter or retract them. Authors can read and delete only their own
    // (that is what lets account deletion honestly purge everything the account
    // wrote), and filing one opens nothing else to its author: the discovery read
    // rule does not count a report as knowing somebody, because anybody can file
    // one. The project owner reviews the queue in the Firebase console or with
    // admin credentials.
    match /reports/{reportId} {

      function reportOk(d) {
        return d.keys().hasOnly(['id', 'from', 'about', 'reason', 'details', 'createdAt'])
          && d.from == request.auth.uid
          && d.about is string && d.about.size() > 0
          && d.about != d.from
          && reportId == d.from + '_' + d.about
          // A real account, by either of two proofs. `discovery/{about}` alone let
          // a matched harasser opt out of the queue: that document is theirs to
          // delete whenever they like, and nothing a conversation needs depends on
          // it — a message is allowed on membership of the match, never on a
          // projection — so deleting it turned every report about them into a
          // refusal while they went on writing. The match is the proof they cannot
          // remove without also losing the thread, and the pair id is built from
          // this report's own two uids, so somebody else's match proves nothing.
          // It is asked second, so a report about a published account costs the
          // one read it always did.
          && (exists(/databases/$(database)/documents/discovery/$(d.about))
              || exists(/databases/$(database)/documents/matches/$(d.from < d.about
                   ? d.from + '_' + d.about : d.about + '_' + d.from)))
          && d.reason in ['fake-profile', 'inappropriate-content', 'harassment', 'underage', 'scam-or-spam', 'other']
          && (!('details' in d) || (d.details is string && d.details.size() <= 500))
          // `id` was on the key list above with no validator at all — the same
          // oversight `discovery/{uid}`'s `location` had, and the swipe, match and
          // message rules all pin their `id` to the document id. Without it the one
          // collection whose entire design is "a deterministic id bounds the queue"
          // accepted a megabyte under the field named `id`, and the queue it bounds
          // is the abuse queue.
          && (!('id' in d) || (d.id == reportId))
          && stampOk(d.createdAt);
      }

      allow create: if isSignedIn() && reportOk(request.resource.data);

      // Only your own reports, and only ever your own: list queries must be
      // constrained to from == you. Reads of missing documents deny too, so a
      // probe of `x_y` cannot distinguish "no such report" from "not yours" —
      // the reported party can never learn a report about them exists.
      allow read: if isSignedIn()
        && resource != null
        && resource.data.from == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // ---------------------------------------------------------------------------
    // Everything else is denied. New collections must opt in above, explicitly.
    // ---------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
